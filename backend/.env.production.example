NODE_ENV=production
BUGSHAPER_ORIGIN=https://bugshaper.xyz
BUGSHAPER_HOST=0.0.0.0
BUGSHAPER_TRUST_PROXY=1
BUGSHAPER_MEDIA_DIR=/data/media

# PostgreSQL (Compose service hostname is "postgres")
DATABASE_URL=postgres://bugshaper:bugshaper@postgres:5432/bugshaper

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

