pipeline {
  agent {
    docker {
      image 'node:22-bookworm-slim'
    }
  }
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }
  stages {
    stage('Test') {
      steps { sh 'npm test' }
    }
    stage('Package') {
      steps { sh 'npm run package' }
    }
  }
}
