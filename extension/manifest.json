{
  "manifest_version": 3,
  "name": "Bugshaper",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Capture screenshots and scoped debugging evidence into your Bugshaper workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "storage",
    "cookies"
  ],
  "optional_host_permissions": [
    "http://localhost:4318/*",
    "http://127.0.0.1:4318/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/brand/icon-16.png",
      "32": "assets/brand/icon-32.png",
      "48": "assets/brand/icon-48.png",
      "128": "assets/brand/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/brand/icon-16.png",
    "32": "assets/brand/icon-32.png",
    "48": "assets/brand/icon-48.png",
    "128": "assets/brand/icon-128.png"
  }
}
