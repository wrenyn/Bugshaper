pipeline {
  agent {
    docker {
      image 'node:22-bookworm-slim'
    }
  }
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }
  stages {
    stage('Install') {
      steps { sh 'npm ci' }
    }
    stage('Check') {
      steps { sh 'npm run check' }
    }
    stage('Build') {
      steps {
        sh 'npm run build'
        sh 'test -f dist/app/app.js && test -f dist/asset-manifest.json'
      }
    }
    stage('Test') {
      steps { sh 'npm test' }
    }
  }
}
